#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
BIN="$ROOT/pt-reverse/bin"
LIVE=0

usage() {
  cat <<'EOF'
Usage: pt730-selftest [--live]

Runs the offline PT 7.3.0 automation self-test:
  shell syntax -> Python compile -> JSON parse -> safety policy checks.

By default this does not contact live Packet Tracer.  Pass --live to add the
safe bridge status/count probe after the offline checks pass.
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --live)
      LIVE=1
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "pt730-selftest: unknown argument: $1" >&2
      usage >&2
      exit 2
      ;;
  esac
done

tmp="$(mktemp -d)"
cleanup() {
  rm -rf "$tmp"
  find "$ROOT/pt-reverse" -path "$ROOT/pt-reverse/upstream" -prune -o -type d -name __pycache__ -prune -exec rm -rf {} + 2>/dev/null || true
  find "$ROOT/pt-reverse" -path "$ROOT/pt-reverse/upstream" -prune -o -type f -name '*.pyc' -delete 2>/dev/null || true
}
trap cleanup EXIT

ok() {
  printf '[ok] %s\n' "$1"
}

expect_fail() {
  local label="$1"
  shift
  if "$@" >"$tmp/${label}.out" 2>"$tmp/${label}.err"; then
    echo "pt730-selftest: expected failure but command passed: $label" >&2
    cat "$tmp/${label}.out" "$tmp/${label}.err" >&2
    exit 1
  fi
}

for file in "$BIN"/pt730-*; do
  first_line="$(head -n 1 "$file")"
  case "$first_line" in
    *bash*)
      bash -n "$file"
      ;;
    *python*)
      python3 -m py_compile "$file"
      ;;
  esac
done
ok "launcher syntax"

python3 -m py_compile "$ROOT"/pt-reverse/pt730/*.py
ok "python modules compile"

while IFS= read -r json_file; do
  python3 -m json.tool "$json_file" >/dev/null
done < <(find "$ROOT/pt-reverse/examples" "$ROOT/pt-reverse/course-design" -maxdepth 1 -type f -name '*.json' | sort)
python3 -m json.tool "$ROOT/pt-reverse/pt730/model_validations.json" >/dev/null
ok "json files parse"

"$BIN/pt730-safety" plan "$ROOT/pt-reverse/examples/simple-lan.json" >/dev/null
"$BIN/pt730-safety" plan "$ROOT/pt-reverse/examples/server-dhcp-lan.json" >/dev/null
expect_fail server-dhcp-strict "$BIN/pt730-safety" plan "$ROOT/pt-reverse/examples/server-dhcp-lan.json" --strict
printf '%s' '{"devices":[{"name":"BAD","model":"3560-24PS"}]}' >"$tmp/risky-plan.json"
expect_fail risky-plan "$BIN/pt730-safety" plan "$tmp/risky-plan.json"
"$BIN/pt730-safety" js 'ipc.network().getDeviceCount()' >/dev/null
expect_fail risky-js "$BIN/pt730-safety" js 'x.getProcess("DhcpClientProcess").dhcpRun("FastEthernet0")'
expect_fail eval-risk-guard "$BIN/pt730-eval" --expr 'x.getProcess("DhcpClientProcess").dhcpRun("FastEthernet0")'
"$BIN/pt730-topo" --timeout 1 apply --dry-run "$ROOT/pt-reverse/examples/simple-lan.json" >/dev/null
"$BIN/pt730-mcp" --list-tools | python3 -m json.tool >/dev/null
printf '%s\n' '{"jsonrpc":"2.0","id":1,"method":"tools/call","params":{"name":"pt730_render","arguments":{"format":"summary","plan":"pt-reverse/examples/simple-lan.json"}}}' | "$BIN/pt730-mcp" | python3 -m json.tool >/dev/null
printf '%s\n' '{"jsonrpc":"2.0","id":1,"method":"tools/call","params":{"name":"pt730_live_apply","arguments":{"plan":"pt-reverse/examples/simple-lan.json","dry_run":true}}}' | "$BIN/pt730-mcp" | python3 -m json.tool >/dev/null
"$BIN/pt730-ip-plan" schema | python3 -m json.tool >/dev/null
"$BIN/pt730-ip-plan" campus "$ROOT/pt-reverse/examples/ip-plan-campus.json" --output "$tmp/ip-plan.json"
python3 -m json.tool "$tmp/ip-plan.json" >/dev/null
ok "ip planning checks"
"$BIN/pt730-compose" schema | python3 -m json.tool >/dev/null
"$BIN/pt730-compose" campus "$ROOT/pt-reverse/examples/compose-campus.json" --segments-from-ip-plan "$tmp/ip-plan.json" --output "$tmp/compose-plan.json"
"$BIN/pt730-safety" plan "$tmp/compose-plan.json" >/dev/null
"$BIN/pt730-render" summary "$tmp/compose-plan.json" >/dev/null
"$BIN/pt730-render" svg "$tmp/compose-plan.json" >/dev/null
"$BIN/pt730-render" drawio "$tmp/compose-plan.json" >/dev/null
"$BIN/pt730-render" html "$tmp/compose-plan.json" >/dev/null
ok "compose checks"
"$BIN/pt730-pipeline" schema | python3 -m json.tool >/dev/null
"$BIN/pt730-pipeline" campus --ip-plan "$ROOT/pt-reverse/examples/ip-plan-campus.json" --compose-spec "$ROOT/pt-reverse/examples/compose-campus.json" --output-dir "$tmp/pipeline" --routing rip >/dev/null
test -s "$tmp/pipeline/topology.layout.json"
test -s "$tmp/pipeline/topology.svg"
test -s "$tmp/pipeline/topology.html"
test -s "$tmp/pipeline/topology.drawio"
test -s "$tmp/pipeline/configs/MLS1.cfg"
ok "pipeline checks"
"$BIN/pt730-template" schema | python3 -m json.tool >/dev/null
"$BIN/pt730-template" lan-star --pcs 2 --servers 1 --network 192.168.10.0/24 --output "$tmp/lan-star.json"
"$BIN/pt730-safety" plan "$tmp/lan-star.json" >/dev/null
"$BIN/pt730-render" summary "$tmp/lan-star.json" >/dev/null
"$BIN/pt730-template" router-ring --routers 4 --interconnect-pool 10.20.0.0/28 --output "$tmp/router-ring.json"
"$BIN/pt730-safety" plan "$tmp/router-ring.json" >/dev/null
"$BIN/pt730-render" summary "$tmp/router-ring.json" >/dev/null
ok "template checks"
"$BIN/pt730-config-plan" schema | python3 -m json.tool >/dev/null
"$BIN/pt730-config-plan" campus "$tmp/compose-plan.json" --output "$tmp/configured-plan.json"
"$BIN/pt730-safety" plan "$tmp/configured-plan.json" >/dev/null
"$BIN/pt730-render" summary "$tmp/configured-plan.json" >/dev/null
"$BIN/pt730-config-plan" export-configs "$tmp/configured-plan.json" --output-dir "$tmp/configs" | python3 -m json.tool >/dev/null
test -s "$tmp/configs/MLS1.cfg"
"$BIN/pt730-config-plan" campus "$ROOT/pt-reverse/course-design/college-network-topology-pt73-safe.json" --l3 --routing rip --output "$tmp/l3-configured-plan.json"
"$BIN/pt730-safety" plan "$tmp/l3-configured-plan.json" >/dev/null
"$BIN/pt730-render" summary "$tmp/l3-configured-plan.json" >/dev/null
"$BIN/pt730-config-plan" campus "$ROOT/pt-reverse/course-design/college-network-topology-pt73-safe.json" --l3 --routing static --output "$tmp/static-configured-plan.json"
"$BIN/pt730-safety" plan "$tmp/static-configured-plan.json" >/dev/null
"$BIN/pt730-render" summary "$tmp/static-configured-plan.json" >/dev/null
ok "config planning checks"
printf '%s' '{"devices":[{"name":"R1","category":"router","model":"2911"},{"name":"SW1","category":"switch","model":"2960-24TT"},{"name":"PC1","category":"pc","model":"PC-PT"}],"links":[{"a":"R1","pa":"GigabitEthernet0/0","b":"SW1","pb":"FastEthernet0/1","cable":"straight"},{"a":"SW1","pa":"FastEthernet0/2","b":"PC1","pb":"FastEthernet0","cable":"straight"}]}' >"$tmp/layout-input.json"
"$BIN/pt730-layout" "$tmp/layout-input.json" --style lan --output "$tmp/layout-output.json"
"$BIN/pt730-safety" plan "$tmp/layout-output.json" >/dev/null
"$BIN/pt730-render" summary "$tmp/layout-output.json" >/dev/null
"$BIN/pt730-layout" "$ROOT/pt-reverse/course-design/college-network-topology-pt73-safe.json" --style campus --preserve-existing --output "$tmp/layout-campus.json"
python3 -m json.tool "$tmp/layout-campus.json" >/dev/null
ok "layout checks"
"$BIN/pt730-render" mermaid "$ROOT/pt-reverse/examples/simple-lan.json" >/dev/null
"$BIN/pt730-render" svg "$ROOT/pt-reverse/examples/simple-lan.json" >/dev/null
"$BIN/pt730-render" drawio "$ROOT/pt-reverse/examples/simple-lan.json" >/dev/null
"$BIN/pt730-render" html "$ROOT/pt-reverse/examples/simple-lan.json" >/dev/null
"$BIN/pt730-render" markdown "$ROOT/pt-reverse/examples/simple-lan.json" >/dev/null
"$BIN/pt730-render" summary "$ROOT/pt-reverse/examples/simple-lan.json" >/dev/null
"$BIN/pt730-render" course-audit "$ROOT/pt-reverse/course-design/college-network-topology-pt73-safe.json" >/dev/null
"$BIN/pt730-models" manifest >/dev/null
"$BIN/pt730-models" queue >/dev/null
"$BIN/pt730-models" probe-plan 1841 >/dev/null
"$BIN/pt730-models" validate 1841 --dry-run >/dev/null
"$BIN/pt730-models" validate-batch --dry-run --limit 2 >/dev/null
expect_fail auto-record-failure env PT730_MODEL_VALIDATIONS="$tmp/auto-record-validations.json" "$BIN/pt730-models" validate 1841 --live --bridge http://127.0.0.1:1 --timeout 0.1 --record-failure-status risky
PT730_MODEL_VALIDATIONS="$tmp/auto-record-validations.json" "$BIN/pt730-models" manifest | python3 -m json.tool >/dev/null
PT730_MODEL_VALIDATIONS="$tmp/model-validations.json" "$BIN/pt730-models" record 1841 --status risky --reason "selftest crash record" --evidence "synthetic" >/dev/null
printf '%s' '{"devices":[{"name":"R1","category":"router","model":"1841"}]}' >"$tmp/risky-overlay-plan.json"
if PT730_MODEL_VALIDATIONS="$tmp/model-validations.json" "$BIN/pt730-safety" plan "$tmp/risky-overlay-plan.json" >/dev/null; then
  echo "expected validation overlay to reject risky model" >&2
  exit 1
fi
printf '%s' '{"device":"R1","hostname":"R1","vlans":[{"id":10}],"interfaces":[{"name":"GigabitEthernet0/0","ip":"10.0.0.1","mask":"255.255.255.0","acl_in":10}],"acls":[{"number":10,"rules":[{"action":"permit","source":"10.0.0.0","wildcard":"0.0.0.255"}]}]}' >"$tmp/ios-template.json"
"$BIN/pt730-ios-template" render "$tmp/ios-template.json" >/dev/null
"$BIN/pt730-ios-template" render "$tmp/ios-template.json" --topology-json >/dev/null
"$BIN/pt730-ios-template" schema | python3 -m json.tool >/dev/null
printf '%s' '{"devices":[{"device":"R1","hostname":"R1","rip":{"version":2,"networks":["10.0.0.0"]}},{"device":"SW1","hostname":"SW1","vlans":[{"id":10}]}]}' >"$tmp/ios-template-batch.json"
"$BIN/pt730-ios-template" render "$tmp/ios-template-batch.json" --topology-json >/dev/null
printf '%s' '{"devices":[{"name":"R1","model":"2911","command_line":{"prompt":"R1#","output_tail":"interface GigabitEthernet0/0\n ip address 10.0.0.1 255.255.255.0\n ip access-group 10 in\nrouter rip\n network 10.0.0.0\n"}}],"links":[]}' >"$tmp/query.json"
"$BIN/pt730-topo" summarize-query "$tmp/query.json" >/dev/null
"$BIN/pt730-topo" export --from-query "$tmp/query.json" --raw-out "$tmp/query-raw.json" --summary-out "$tmp/query-summary.json" >/dev/null
"$BIN/pt730-topo" export --from-query "$tmp/query.json" --raw-out "$tmp/query-raw2.json" --summary-out "$tmp/query-summary2.json" --markdown-out "$tmp/query-summary.md" >/dev/null
"$BIN/pt730-render" markdown "$ROOT/pt-reverse/examples/simple-lan.json" --output "$tmp/simple-lan.md"
test -s "$tmp/simple-lan.md"
"$BIN/pt730-render" svg "$ROOT/pt-reverse/examples/simple-lan.json" --output "$tmp/simple-lan.svg"
test -s "$tmp/simple-lan.svg"
"$BIN/pt730-render" drawio "$ROOT/pt-reverse/examples/simple-lan.json" --output "$tmp/simple-lan.drawio"
test -s "$tmp/simple-lan.drawio"
"$BIN/pt730-render" html "$ROOT/pt-reverse/examples/simple-lan.json" --output "$tmp/simple-lan.html"
test -s "$tmp/simple-lan.html"
ok "safety policy checks"

if [[ "$LIVE" -eq 1 ]]; then
  "$BIN/pt730-bridge" status
  "$BIN/pt730-app" --timeout 8 count
  ok "live bridge count"
fi

echo "pt730-selftest: OK"
