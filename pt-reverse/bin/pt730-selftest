#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
BIN="$ROOT/pt-reverse/bin"
LIVE=0

usage() {
  cat <<'EOF'
Usage: pt730-selftest [--live]

Runs the offline PT 7.3.0 automation self-test:
  shell syntax -> Python compile -> JSON parse -> safety policy checks.

By default this does not contact live Packet Tracer.  Pass --live to add the
safe bridge status/count probe after the offline checks pass.
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --live)
      LIVE=1
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "pt730-selftest: unknown argument: $1" >&2
      usage >&2
      exit 2
      ;;
  esac
done

tmp="$(mktemp -d)"
cleanup() {
  rm -rf "$tmp"
  find "$ROOT/pt-reverse" -path "$ROOT/pt-reverse/upstream" -prune -o -type d -name __pycache__ -prune -exec rm -rf {} + 2>/dev/null || true
  find "$ROOT/pt-reverse" -path "$ROOT/pt-reverse/upstream" -prune -o -type f -name '*.pyc' -delete 2>/dev/null || true
}
trap cleanup EXIT

ok() {
  printf '[ok] %s\n' "$1"
}

expect_fail() {
  local label="$1"
  shift
  if "$@" >"$tmp/${label}.out" 2>"$tmp/${label}.err"; then
    echo "pt730-selftest: expected failure but command passed: $label" >&2
    cat "$tmp/${label}.out" "$tmp/${label}.err" >&2
    exit 1
  fi
}

for file in "$BIN"/pt730-*; do
  first_line="$(head -n 1 "$file")"
  case "$first_line" in
    *bash*)
      bash -n "$file"
      ;;
    *python*)
      python3 -m py_compile "$file"
      ;;
  esac
done
ok "launcher syntax"

python3 -m py_compile "$ROOT"/pt-reverse/pt730/*.py
ok "python modules compile"

while IFS= read -r json_file; do
  python3 -m json.tool "$json_file" >/dev/null
done < <(find "$ROOT/pt-reverse/examples" "$ROOT/pt-reverse/course-design" -maxdepth 1 -type f -name '*.json' | sort)
python3 -m json.tool "$ROOT/pt-reverse/pt730/model_validations.json" >/dev/null
ok "json files parse"

"$BIN/pt730-safety" plan "$ROOT/pt-reverse/examples/simple-lan.json" >/dev/null
"$BIN/pt730-safety" plan "$ROOT/pt-reverse/examples/server-dhcp-lan.json" >/dev/null
expect_fail server-dhcp-strict "$BIN/pt730-safety" plan "$ROOT/pt-reverse/examples/server-dhcp-lan.json" --strict
printf '%s' '{"devices":[{"name":"BAD","model":"3560-24PS"}]}' >"$tmp/risky-plan.json"
expect_fail risky-plan "$BIN/pt730-safety" plan "$tmp/risky-plan.json"
"$BIN/pt730-safety" js 'ipc.network().getDeviceCount()' >/dev/null
expect_fail risky-js "$BIN/pt730-safety" js 'x.getProcess("DhcpClientProcess").dhcpRun("FastEthernet0")'
expect_fail eval-risk-guard "$BIN/pt730-eval" --expr 'x.getProcess("DhcpClientProcess").dhcpRun("FastEthernet0")'
"$BIN/pt730-topo" --timeout 1 apply --dry-run "$ROOT/pt-reverse/examples/simple-lan.json" >/dev/null
"$BIN/pt730-mcp" --list-tools | python3 -m json.tool >/dev/null
printf '%s\n' '{"jsonrpc":"2.0","id":1,"method":"tools/call","params":{"name":"pt730_capabilities","arguments":{"compact":true}}}' | "$BIN/pt730-mcp" | python3 -m json.tool >/dev/null
printf '%s\n' '{"jsonrpc":"2.0","id":1,"method":"tools/call","params":{"name":"pt730_schema","arguments":{"target":"compose","compact":true}}}' | "$BIN/pt730-mcp" | python3 -m json.tool >/dev/null
printf '%s\n' '{"jsonrpc":"2.0","id":1,"method":"tools/call","params":{"name":"pt730_template_lan_star","arguments":{"name":"AGENT","pcs":1,"servers":1,"network":"192.168.60.0/24","gateway":"192.168.60.1","dns":"192.168.60.254","layout_style":"grid","no_layout":true,"compact":true}}}' | "$BIN/pt730-mcp" | python3 -m json.tool >/dev/null
printf '%s\n' '{"jsonrpc":"2.0","id":1,"method":"tools/call","params":{"name":"pt730_template_wireless_lan","arguments":{"name":"AGENT","aps":2,"laptops":3,"servers":1,"network":"192.168.80.0/24","gateway":"192.168.80.1","ssid":"PT730-LAB","compact":true}}}' | "$BIN/pt730-mcp" | python3 -m json.tool >/dev/null
printf '%s\n' '{"jsonrpc":"2.0","id":1,"method":"tools/call","params":{"name":"pt730_template_vlan_router_on_stick","arguments":{"name":"AGENT","vlans":2,"hosts_per_vlan":1,"servers_per_vlan":1,"address_pool":"192.168.30.0/23","native_vlan":10,"client_addressing":"dhcp","compact":true}}}' | "$BIN/pt730-mcp" | python3 -m json.tool >/dev/null
printf '%s\n' '{"jsonrpc":"2.0","id":1,"method":"tools/call","params":{"name":"pt730_template_edge_security","arguments":{"name":"AGENT","inside_hosts":2,"dmz_servers":2,"internet_hosts":1,"domain":"edge.local","compact":true}}}' | "$BIN/pt730-mcp" | python3 -m json.tool >/dev/null
printf '%s\n' '{"jsonrpc":"2.0","id":1,"method":"tools/call","params":{"name":"pt730_template_wan_ring","arguments":{"name":"AGENT","sites":3,"hosts_per_site":1,"servers_per_site":1,"routing":"ospf","compact":true}}}' | "$BIN/pt730-mcp" | python3 -m json.tool >/dev/null
printf '%s\n' '{"jsonrpc":"2.0","id":1,"method":"tools/call","params":{"name":"pt730_template_campus","arguments":{"name":"AGENT","cores":2,"segments":2,"hosts_per_segment":1,"servers":2,"l3":true,"routing":"ospf","compact":true}}}' | "$BIN/pt730-mcp" | python3 -m json.tool >/dev/null
printf '%s\n' '{"jsonrpc":"2.0","id":1,"method":"tools/call","params":{"name":"pt730_template_redundant_campus","arguments":{"name":"AGENT","segments":2,"hosts_per_segment":1,"servers":4,"routing":"ospf","compact":true}}}' | "$BIN/pt730-mcp" | python3 -m json.tool >/dev/null
printf '%s\n' '{"jsonrpc":"2.0","id":1,"method":"tools/call","params":{"name":"pt730_ip_plan_campus","arguments":{"spec":"pt-reverse/examples/ip-plan-campus.json","compact":true}}}' | "$BIN/pt730-mcp" | python3 -m json.tool >/dev/null
printf '%s\n' '{"jsonrpc":"2.0","id":1,"method":"tools/call","params":{"name":"pt730_compose_campus","arguments":{"spec":"pt-reverse/examples/compose-campus.json","layout_style":"grid","compact":true}}}' | "$BIN/pt730-mcp" | python3 -m json.tool >/dev/null
printf '%s\n' '{"jsonrpc":"2.0","id":1,"method":"tools/call","params":{"name":"pt730_layout","arguments":{"plan":"pt-reverse/examples/simple-lan.json","style":"grid","canvas_width":400,"canvas_height":300,"spacing_x":120,"spacing_y":100,"margin":20,"compact":true}}}' | "$BIN/pt730-mcp" | python3 -m json.tool >/dev/null
printf '%s\n' '{"jsonrpc":"2.0","id":1,"method":"tools/call","params":{"name":"pt730_config_plan_campus","arguments":{"plan":"pt-reverse/course-design/college-network-topology-pt73-safe.json","ios_only":true,"compact":true}}}' | "$BIN/pt730-mcp" | python3 -m json.tool >/dev/null
printf '%s\n' '{"jsonrpc":"2.0","id":1,"method":"tools/call","params":{"name":"pt730_render","arguments":{"format":"svg","plan":"pt-reverse/examples/simple-lan.json","theme":"dark","link_labels":false,"model_labels":false,"group_by":"network"}}}' | "$BIN/pt730-mcp" | python3 -m json.tool >/dev/null
printf '%s\n' '{"jsonrpc":"2.0","id":1,"method":"tools/call","params":{"name":"pt730_render","arguments":{"format":"summary","plan":"pt-reverse/examples/simple-lan.json"}}}' | "$BIN/pt730-mcp" | python3 -m json.tool >/dev/null
printf '%s\n' '{"jsonrpc":"2.0","id":1,"method":"tools/call","params":{"name":"pt730_render_bundle","arguments":{"plan":"pt-reverse/examples/simple-lan.json","output_dir":"'"$tmp"'/mcp-render-bundle","basename":"simple","formats":["svg","summary"],"theme":"dark","link_labels":false,"model_labels":false,"group_by":"network"}}}' | "$BIN/pt730-mcp" | python3 -m json.tool >/dev/null
test -s "$tmp/mcp-render-bundle/simple.manifest.json"
printf '%s\n' '{"jsonrpc":"2.0","id":1,"method":"tools/call","params":{"name":"pt730_catalog","arguments":{"action":"ports","model":"2911"}}}' | "$BIN/pt730-mcp" | python3 -m json.tool >/dev/null
printf '%s\n' '{"jsonrpc":"2.0","id":1,"method":"tools/call","params":{"name":"pt730_safety_js","arguments":{"code":"ipc.network().getDeviceCount()"}}}' | "$BIN/pt730-mcp" | python3 -m json.tool >/dev/null
printf '%s\n' '{"jsonrpc":"2.0","id":1,"method":"tools/call","params":{"name":"pt730_live_apply","arguments":{"plan":"pt-reverse/examples/simple-lan.json","dry_run":true}}}' | "$BIN/pt730-mcp" | python3 -m json.tool >/dev/null
printf '%s\n' '{"jsonrpc":"2.0","id":1,"method":"tools/call","params":{"name":"pt730_live_ios","arguments":{"device":"R1","commands":["show ip interface brief"],"dry_run":true}}}' | "$BIN/pt730-mcp" | python3 -m json.tool >/dev/null
printf '%s\n' '{"jsonrpc":"2.0","id":1,"method":"tools/call","params":{"name":"pt730_live_pc_dhcp","arguments":{"device":"PC1","renew":true,"wait":10,"expect_network":"192.168.1.0/24","dry_run":true}}}' | "$BIN/pt730-mcp" | python3 -m json.tool >/dev/null
printf '%s\n' '{"jsonrpc":"2.0","id":1,"method":"tools/call","params":{"name":"pt730_live_server_dns_add","arguments":{"device":"SRV1","hostname":"www.example.local","ip":"172.16.1.10","dry_run":true}}}' | "$BIN/pt730-mcp" | python3 -m json.tool >/dev/null
printf '%s\n' '{"jsonrpc":"2.0","id":1,"method":"tools/call","params":{"name":"pt730_live_server_email_add","arguments":{"device":"SRV1","username":"student","password":"packet","domain":"example.local","dry_run":true}}}' | "$BIN/pt730-mcp" | python3 -m json.tool >/dev/null
printf '%s\n' '{"jsonrpc":"2.0","id":1,"method":"tools/call","params":{"name":"pt730_live_server_email_remove","arguments":{"device":"SRV1","username":"student","dry_run":true}}}' | "$BIN/pt730-mcp" | python3 -m json.tool >/dev/null
printf '%s\n' '{"jsonrpc":"2.0","id":1,"method":"tools/call","params":{"name":"pt730_live_server_ftp_remove","arguments":{"device":"SRV1","username":"student","dry_run":true}}}' | "$BIN/pt730-mcp" | python3 -m json.tool >/dev/null
printf '%s\n' '{"jsonrpc":"2.0","id":1,"method":"tools/call","params":{"name":"pt730_live_server_ntp_config","arguments":{"device":"SRV1","enabled":true,"auth":"on","key_id":"1","md5":"cisco","dry_run":true}}}' | "$BIN/pt730-mcp" | python3 -m json.tool >/dev/null
printf '%s\n' '{"jsonrpc":"2.0","id":1,"method":"tools/call","params":{"name":"pt730_live_server_syslog_config","arguments":{"device":"SRV1","enabled":false,"port":514,"dry_run":true}}}' | "$BIN/pt730-mcp" | python3 -m json.tool >/dev/null
printf '%s\n' '{"jsonrpc":"2.0","id":1,"method":"tools/call","params":{"name":"pt730_live_ftp","arguments":{"client":"PC1","server":"172.16.1.10","commands":["dir"],"dry_run":true}}}' | "$BIN/pt730-mcp" | python3 -m json.tool >/dev/null
printf '%s\n' '{"jsonrpc":"2.0","id":1,"method":"tools/call","params":{"name":"pt730_live_sim","arguments":{"action":"simple_pdu","source":"PC1","target":"SRV1","dry_run":true}}}' | "$BIN/pt730-mcp" | python3 -m json.tool >/dev/null
printf '%s\n' '{"jsonrpc":"2.0","id":1,"method":"tools/call","params":{"name":"pt730_topo_summarize_query","arguments":{"query_json":"pt-reverse/examples/simple-lan-live-query.json"}}}' | "$BIN/pt730-mcp" | python3 -m json.tool >/dev/null
printf '%s\n' '{"jsonrpc":"2.0","id":1,"method":"tools/call","params":{"name":"pt730_models_validate","arguments":{"model":"2911","dry_run":true}}}' | "$BIN/pt730-mcp" | python3 -m json.tool >/dev/null
printf '%s\n' '{"jsonrpc":"2.0","id":1,"method":"tools/call","params":{"name":"pt730_models_record","arguments":{"model":"2911","status":"risky","reason":"selftest preview","dry_run":true}}}' | "$BIN/pt730-mcp" | python3 -m json.tool >/dev/null
printf '%s\n' '{"jsonrpc":"2.0","id":1,"method":"tools/call","params":{"name":"pt730_live_recover","arguments":{"wait":5,"notify":true,"dry_run":true}}}' | "$BIN/pt730-mcp" | python3 -m json.tool >/dev/null
printf '%s\n' '{"jsonrpc":"2.0","id":1,"method":"tools/call","params":{"name":"pt730_live_eval","arguments":{"code":"ipc.network().getDeviceCount()","expr":true,"dry_run":true}}}' | "$BIN/pt730-mcp" | python3 -m json.tool >/dev/null
printf '%s\n' '{"jsonrpc":"2.0","id":1,"method":"tools/call","params":{"name":"pt730_live_smoke","arguments":{"plan":"pt-reverse/examples/server-dhcp-lan.json","no_apply":true,"dry_run":true}}}' | "$BIN/pt730-mcp" | python3 -m json.tool >/dev/null
"$BIN/pt730-ip-plan" schema | python3 -m json.tool >/dev/null
"$BIN/pt730-ip-plan" campus "$ROOT/pt-reverse/examples/ip-plan-campus.json" --output "$tmp/ip-plan.json"
python3 -m json.tool "$tmp/ip-plan.json" >/dev/null
ok "ip planning checks"
"$BIN/pt730-compose" schema | python3 -m json.tool >/dev/null
"$BIN/pt730-compose" campus "$ROOT/pt-reverse/examples/compose-campus.json" --segments-from-ip-plan "$tmp/ip-plan.json" --output "$tmp/compose-plan.json"
"$BIN/pt730-safety" plan "$tmp/compose-plan.json" >/dev/null
"$BIN/pt730-render" summary "$tmp/compose-plan.json" >/dev/null
"$BIN/pt730-render" svg "$tmp/compose-plan.json" >/dev/null
"$BIN/pt730-render" drawio "$tmp/compose-plan.json" >/dev/null
"$BIN/pt730-render" html "$tmp/compose-plan.json" >/dev/null
ok "compose checks"
"$BIN/pt730-pipeline" schema | python3 -m json.tool >/dev/null
"$BIN/pt730-pipeline" campus --ip-plan "$ROOT/pt-reverse/examples/ip-plan-campus.json" --compose-spec "$ROOT/pt-reverse/examples/compose-campus.json" --output-dir "$tmp/pipeline" --routing rip >/dev/null
test -s "$tmp/pipeline/topology.layout.json"
test -s "$tmp/pipeline/topology.svg"
test -s "$tmp/pipeline/topology.html"
test -s "$tmp/pipeline/topology.drawio"
test -s "$tmp/pipeline/configs/MLS1.cfg"
ok "pipeline checks"
"$BIN/pt730-template" schema | python3 -m json.tool >/dev/null
"$BIN/pt730-template" lan-star --pcs 2 --servers 1 --network 192.168.10.0/24 --output "$tmp/lan-star.json"
"$BIN/pt730-safety" plan "$tmp/lan-star.json" >/dev/null
"$BIN/pt730-render" summary "$tmp/lan-star.json" >/dev/null
"$BIN/pt730-template" wireless-lan --name AGENT --aps 2 --laptops 3 --servers 1 --network 192.168.80.0/24 --ssid PT730-LAB --output "$tmp/wireless-lan.json"
"$BIN/pt730-safety" plan "$tmp/wireless-lan.json" >/dev/null
"$BIN/pt730-render" summary "$tmp/wireless-lan.json" >/dev/null
"$BIN/pt730-template" vlan-router-on-stick --name AGENT --vlans 2 --hosts-per-vlan 1 --servers-per-vlan 1 --address-pool 192.168.30.0/23 --native-vlan 10 --output "$tmp/vlan-router-on-stick.json"
"$BIN/pt730-safety" plan "$tmp/vlan-router-on-stick.json" >/dev/null
"$BIN/pt730-render" summary "$tmp/vlan-router-on-stick.json" >/dev/null
"$BIN/pt730-template" vlan-router-on-stick --name DHCP --vlans 2 --hosts-per-vlan 2 --servers-per-vlan 1 --address-pool 192.168.40.0/23 --client-addressing dhcp --output "$tmp/vlan-router-on-stick-dhcp.json"
"$BIN/pt730-safety" plan "$tmp/vlan-router-on-stick-dhcp.json" >/dev/null
"$BIN/pt730-render" summary "$tmp/vlan-router-on-stick-dhcp.json" >/dev/null
"$BIN/pt730-template" edge-security --name AGENT --inside-hosts 2 --dmz-servers 2 --internet-hosts 1 --domain edge.local --output "$tmp/edge-security.json"
"$BIN/pt730-safety" plan "$tmp/edge-security.json" >/dev/null
"$BIN/pt730-render" summary "$tmp/edge-security.json" >/dev/null
"$BIN/pt730-template" router-ring --routers 4 --interconnect-pool 10.20.0.0/28 --output "$tmp/router-ring.json"
"$BIN/pt730-safety" plan "$tmp/router-ring.json" >/dev/null
"$BIN/pt730-render" summary "$tmp/router-ring.json" >/dev/null
"$BIN/pt730-template" wan-ring --name AGENT --sites 3 --hosts-per-site 2 --servers-per-site 1 --routing static --output "$tmp/wan-ring.json"
"$BIN/pt730-safety" plan "$tmp/wan-ring.json" >/dev/null
"$BIN/pt730-render" summary "$tmp/wan-ring.json" >/dev/null
"$BIN/pt730-template" wan-ring --name OSPF --sites 3 --hosts-per-site 1 --servers-per-site 0 --routing ospf --output "$tmp/wan-ring-ospf.json"
"$BIN/pt730-safety" plan "$tmp/wan-ring-ospf.json" >/dev/null
"$BIN/pt730-render" summary "$tmp/wan-ring-ospf.json" >/dev/null
"$BIN/pt730-template" campus --name AGENT --cores 2 --segments 3 --hosts-per-segment 2 --servers 4 --l3 --routing rip --output "$tmp/campus-template.json"
"$BIN/pt730-safety" plan "$tmp/campus-template.json" >/dev/null
"$BIN/pt730-render" summary "$tmp/campus-template.json" >/dev/null
"$BIN/pt730-template" redundant-campus --name AGENT --segments 3 --hosts-per-segment 2 --servers 4 --routing ospf --output "$tmp/redundant-campus-template.json"
"$BIN/pt730-safety" plan "$tmp/redundant-campus-template.json" >/dev/null
"$BIN/pt730-render" summary "$tmp/redundant-campus-template.json" >/dev/null
"$BIN/pt730-render" svg "$tmp/redundant-campus-template.json" --group-by auto >/dev/null
ok "template checks"
"$BIN/pt730-config-plan" schema | python3 -m json.tool >/dev/null
"$BIN/pt730-config-plan" campus "$tmp/compose-plan.json" --output "$tmp/configured-plan.json"
"$BIN/pt730-safety" plan "$tmp/configured-plan.json" >/dev/null
"$BIN/pt730-render" summary "$tmp/configured-plan.json" >/dev/null
"$BIN/pt730-config-plan" export-configs "$tmp/configured-plan.json" --output-dir "$tmp/configs" | python3 -m json.tool >/dev/null
test -s "$tmp/configs/MLS1.cfg"
"$BIN/pt730-config-plan" campus "$ROOT/pt-reverse/course-design/college-network-topology-pt73-safe.json" --l3 --routing rip --output "$tmp/l3-configured-plan.json"
"$BIN/pt730-safety" plan "$tmp/l3-configured-plan.json" >/dev/null
"$BIN/pt730-render" summary "$tmp/l3-configured-plan.json" >/dev/null
"$BIN/pt730-config-plan" campus "$ROOT/pt-reverse/course-design/college-network-topology-pt73-safe.json" --l3 --routing static --output "$tmp/static-configured-plan.json"
"$BIN/pt730-safety" plan "$tmp/static-configured-plan.json" >/dev/null
"$BIN/pt730-render" summary "$tmp/static-configured-plan.json" >/dev/null
ok "config planning checks"
printf '%s' '{"devices":[{"name":"R1","category":"router","model":"2911"},{"name":"SW1","category":"switch","model":"2960-24TT"},{"name":"PC1","category":"pc","model":"PC-PT"}],"links":[{"a":"R1","pa":"GigabitEthernet0/0","b":"SW1","pb":"FastEthernet0/1","cable":"straight"},{"a":"SW1","pa":"FastEthernet0/2","b":"PC1","pb":"FastEthernet0","cable":"straight"}]}' >"$tmp/layout-input.json"
"$BIN/pt730-layout" "$tmp/layout-input.json" --style lan --output "$tmp/layout-output.json"
"$BIN/pt730-safety" plan "$tmp/layout-output.json" >/dev/null
"$BIN/pt730-render" summary "$tmp/layout-output.json" >/dev/null
"$BIN/pt730-layout" "$ROOT/pt-reverse/course-design/college-network-topology-pt73-safe.json" --style campus --preserve-existing --output "$tmp/layout-campus.json"
python3 -m json.tool "$tmp/layout-campus.json" >/dev/null
ok "layout checks"
"$BIN/pt730-render" mermaid "$ROOT/pt-reverse/examples/simple-lan.json" >/dev/null
"$BIN/pt730-render" svg "$ROOT/pt-reverse/examples/simple-lan.json" >/dev/null
"$BIN/pt730-render" svg "$ROOT/pt-reverse/examples/simple-lan.json" --group-by network >/dev/null
"$BIN/pt730-render" drawio "$ROOT/pt-reverse/examples/simple-lan.json" >/dev/null
"$BIN/pt730-render" drawio "$ROOT/pt-reverse/examples/simple-lan.json" --group-by network >/dev/null
"$BIN/pt730-render" html "$ROOT/pt-reverse/examples/simple-lan.json" >/dev/null
"$BIN/pt730-render" html "$ROOT/pt-reverse/examples/simple-lan.json" --group-by network >/dev/null
"$BIN/pt730-render" markdown "$ROOT/pt-reverse/examples/simple-lan.json" >/dev/null
"$BIN/pt730-render" summary "$ROOT/pt-reverse/examples/simple-lan.json" >/dev/null
"$BIN/pt730-render" bundle "$ROOT/pt-reverse/examples/simple-lan.json" --output-dir "$tmp/render-bundle" --basename simple --formats svg,drawio,html,markdown,summary --group-by network >/dev/null
test -s "$tmp/render-bundle/simple.svg"
test -s "$tmp/render-bundle/simple.drawio"
test -s "$tmp/render-bundle/simple.html"
test -s "$tmp/render-bundle/simple.md"
test -s "$tmp/render-bundle/simple.summary.json"
test -s "$tmp/render-bundle/simple.manifest.json"
"$BIN/pt730-render" course-audit "$ROOT/pt-reverse/course-design/college-network-topology-pt73-safe.json" >/dev/null
"$BIN/pt730-models" manifest >/dev/null
"$BIN/pt730-models" queue >/dev/null
"$BIN/pt730-models" probe-plan 1841 >/dev/null
"$BIN/pt730-models" validate 1841 --dry-run >/dev/null
"$BIN/pt730-models" validate-batch --dry-run --limit 2 >/dev/null
expect_fail auto-record-failure env PT730_MODEL_VALIDATIONS="$tmp/auto-record-validations.json" "$BIN/pt730-models" validate 1841 --live --bridge http://127.0.0.1:1 --timeout 0.1 --record-failure-status risky
PT730_MODEL_VALIDATIONS="$tmp/auto-record-validations.json" "$BIN/pt730-models" manifest | python3 -m json.tool >/dev/null
PT730_MODEL_VALIDATIONS="$tmp/model-validations.json" "$BIN/pt730-models" record 1841 --status risky --reason "selftest crash record" --evidence "synthetic" >/dev/null
printf '%s' '{"devices":[{"name":"R1","category":"router","model":"1841"}]}' >"$tmp/risky-overlay-plan.json"
if PT730_MODEL_VALIDATIONS="$tmp/model-validations.json" "$BIN/pt730-safety" plan "$tmp/risky-overlay-plan.json" >/dev/null; then
  echo "expected validation overlay to reject risky model" >&2
  exit 1
fi
printf '%s' '{"device":"R1","hostname":"R1","vlans":[{"id":10}],"spanning_tree":{"mode":"rapid-pvst","root_primary":[10],"portfast_default":true},"etherchannels":[{"group":1,"mode":"active","interfaces":["GigabitEthernet0/1","GigabitEthernet0/2"],"port_channel":{"mode":"trunk","allowed_vlans":[10]}}],"interfaces":[{"name":"GigabitEthernet0/0","ip":"10.0.0.1","mask":"255.255.255.0","helper_addresses":["172.16.1.10"],"hsrp":{"group":10,"ip":"10.0.0.254","priority":110,"preempt":true},"acl_in":10}],"dhcp":{"excluded_addresses":[{"start":"10.0.0.1","end":"10.0.0.20"}],"pools":[{"name":"VLAN10","network":"10.0.0.0","mask":"255.255.255.0","default_router":"10.0.0.254","dns_server":["172.16.1.10"]}]},"ntp":{"servers":["172.16.1.20"]},"logging":{"hosts":["172.16.1.30"],"trap":"informational"},"snmp":{"communities":[{"name":"campusRO","mode":"RO"}]},"acls":[{"number":10,"rules":[{"action":"permit","source":"10.0.0.0","wildcard":"0.0.0.255"}]}]}' >"$tmp/ios-template.json"
"$BIN/pt730-ios-template" render "$tmp/ios-template.json" >/dev/null
"$BIN/pt730-ios-template" render "$tmp/ios-template.json" --topology-json >/dev/null
"$BIN/pt730-ios-template" schema | python3 -m json.tool >/dev/null
"$BIN/pt730-ios-template" render "$ROOT/pt-reverse/examples/ios-template-switching.json" >/dev/null
"$BIN/pt730-ios-template" render "$ROOT/pt-reverse/examples/ios-template-fhrp-services.json" >/dev/null
printf '%s' '{"devices":[{"device":"R1","hostname":"R1","rip":{"version":2,"networks":["10.0.0.0"]}},{"device":"SW1","hostname":"SW1","vlans":[{"id":10}]}]}' >"$tmp/ios-template-batch.json"
"$BIN/pt730-ios-template" render "$tmp/ios-template-batch.json" --topology-json >/dev/null
printf '%s' '{"devices":[{"name":"R1","model":"2911","command_line":{"prompt":"R1#","output_tail":"spanning-tree mode rapid-pvst\nspanning-tree vlan 10 root primary\ninterface GigabitEthernet0/0\n ip address 10.0.0.1 255.255.255.0\n ip helper-address 172.16.1.10\n standby 10 ip 10.0.0.254\n standby 10 preempt\n ip access-group 10 in\n channel-group 1 mode active\nip dhcp pool VLAN10\n network 10.0.0.0 255.255.255.0\n default-router 10.0.0.254\nntp server 172.16.1.20\nlogging host 172.16.1.30\nsnmp-server community campusRO RO\nrouter rip\n network 10.0.0.0\n"}}],"links":[]}' >"$tmp/query.json"
"$BIN/pt730-topo" summarize-query "$tmp/query.json" >/dev/null
"$BIN/pt730-topo" export --from-query "$tmp/query.json" --raw-out "$tmp/query-raw.json" --summary-out "$tmp/query-summary.json" >/dev/null
"$BIN/pt730-topo" export --from-query "$tmp/query.json" --raw-out "$tmp/query-raw2.json" --summary-out "$tmp/query-summary2.json" --markdown-out "$tmp/query-summary.md" >/dev/null
"$BIN/pt730-render" markdown "$ROOT/pt-reverse/examples/simple-lan.json" --output "$tmp/simple-lan.md"
test -s "$tmp/simple-lan.md"
